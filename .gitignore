# Python virtual environment
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]

# PyInstaller build artifacts.  SlideShow.spec and Build.bat are NOT artifacts --
# the spec carries real build configuration (the sibling folders to bundle, the face
# model, the icon, no console window) and is tracked, so a rebuilt exe is the same
# exe on any machine.
build/
dist/
*.exe

# IDE
.idea/

# Runtime logs
*.log

# Runtime / per-user state
SlideShow state.json
SlideShow Output *.json

# Working notes
*.docx

# Photo data folders.  Their names vary, so rather than listing them, ignore every
# directory here: the project itself is all top-level files.  (Should a real source
# directory ever be added, exempt it with a "!/name/" line below.)
/*/
!/tests/

# Photo shows (built by the show editor; per-installation)
SlideShow shows.json
